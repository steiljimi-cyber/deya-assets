{
  "name": "fixer-film-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "devserver": "cargo run --release -p fixer-devserver",
    "test": "vitest run",
    "test:rust": "cargo test -p fixer-core",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run test && npm run test:rust && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.2.0",
    "@fontsource/vt323": "^5.2.0",
    "@fontsource/courier-prime": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
